# Values below are DEFAULTS. Most of them (name, language, model, sampling,
# voice, image parameters) can be changed from the Settings panel in the app;
# saved values override this file until "Restore .env values".

# --- Server -------------------------------------------------------------
# Keep 127.0.0.1 unless you know what you are doing: the API has no auth.
HOST=127.0.0.1
PORT=3210

# --- LLM backend -------------------------------------------------------------
# ollama = native Ollama API (recommended: sets the context size on every
#          request, supports MIN_P / REPEAT_PENALTY / LLM_KEEP_ALIVE)
# openai = any OpenAI-compatible server: llama.cpp (http://127.0.0.1:8080),
#          KoboldCpp (http://127.0.0.1:5001), LM Studio…
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=mistral-nemo:12b-instruct-2407-q4_K_M
# Optional, only for backends that require a key (openai provider)
LLM_API_KEY=
# How long Ollama keeps the model in VRAM after the last request (30m, 2h, -1 = forever)
LLM_KEEP_ALIVE=30m

# --- Generation ----------------------------------------------------------
# Context window. With LLM_PROVIDER=ollama it is applied automatically;
# with the openai provider it must match the backend's own setting.
CONTEXT_TOKENS=8192
MAX_REPLY_TOKENS=400
# Lower = more coherent, higher = more creative.
TEMPERATURE=0.7
TOP_P=0.95
# Cuts very unlikely tokens: the best guard against incoherent tangents.
MIN_P=0.05
# >1 discourages repeating the same words/phrases.
REPEAT_PENALTY=1.1

# --- Characters ------------------------------------------------------------
CHARACTERS_DIR=./characters
USER_NAME=Etienne

# --- Language ---------------------------------------------------------------
# Language the character must always answer in (e.g. French, English, Spanish).
# Leave empty to let the model follow the card and your messages.
REPLY_LANGUAGE=French

# --- Memory (step 2) -------------------------------------------------------------
# Conversations, memories and in-app settings are stored in DATA_DIR/girllm.db;
# photos in DATA_DIR/images and reference faces in DATA_DIR/faces (all git-ignored).
DATA_DIR=./data
MEMORY_ENABLED=true
# Embedding model for semantic memory search (run: ollama pull paraphrase-multilingual).
# Multilingual, small (~0.6 GB). Leave empty to pick memories by recency only.
EMBEDDING_MODEL=paraphrase-multilingual
# Defaults to LLM_BASE_URL
EMBEDDING_BASE_URL=
# Max memories injected in each prompt
MEMORY_TOP_K=8
# Extract facts once this many new messages are pending
MEMORY_EXTRACT_EVERY=4

# --- Voice (steps 3 and 7) --------------------------------------------------------
# Your speech: Whisper on the CPU. Her voice: Qwen3-TTS in ComfyUI (COMFYUI_URL / COMFYUI_DIR
# below), designed in the character editor. Install both with:
#   npm run setup:voice           (Whisper models: npm run setup:voice -- --list)
VOICE_ENABLED=true
MODELS_DIR=./models
# whisper-tiny | whisper-base | whisper-small (more accurate, ~3x slower)
STT_MODEL=whisper-base
# Language you speak (two-letter code). Empty = auto-detect.
STT_LANGUAGE=fr
# CPU threads of speech recognition (your i5-11400F has 12)
VOICE_THREADS=4

# --- Photos (step 4) --------------------------------------------------------------
# Needs ComfyUI running (default http://127.0.0.1:8188) and an SDXL checkpoint
# in ComfyUI/models/checkpoints. While a photo is generated, the chat model is
# unloaded from the GPU and reloaded afterwards (8 GB of VRAM can't hold both).
IMAGES_ENABLED=true
COMFYUI_URL=http://127.0.0.1:8188
# Optional: ComfyUI install folder, so start.bat can start it for you, e.g.
# COMFYUI_DIR=C:\AI\ComfyUI_windows_portable
COMFYUI_DIR=
# File name exactly as listed in ComfyUI, e.g. sd_xl_base_1.0.safetensors
IMAGE_CHECKPOINT=
# SDXL portrait format (multiples of 8)
IMAGE_WIDTH=832
IMAGE_HEIGHT=1216
IMAGE_STEPS=25
IMAGE_CFG=5.5
IMAGE_SAMPLER=dpmpp_2m
IMAGE_SCHEDULER=karras
# Style tags added to every photo (e.g. "anime style, cel shading" for an anime look).
# Leave both empty to use the built-in realistic defaults.
IMAGE_STYLE=
IMAGE_NEGATIVE_PROMPT=
# Second refinement pass for sharper faces (1 = off, ~1.6x slower at 1.25)
IMAGE_HIRES_SCALE=1.25
IMAGE_HIRES_DENOISE=0.35
IMAGE_HIRES_STEPS=15
# Keep each character's reference face in her photos (IP-Adapter, run: npm run setup:images).
# 0 = off; 0.6–0.8 keeps her face while leaving the scene free.
IMAGE_FACE_WEIGHT=0.7
# Face detail pass (step 6): a small face (waist-up, full body) is found and redrawn at 1024 px.
# 0–0.7; 0 = off. Needs the face detector (installed by npm run setup:images).
# FLUX.2 [klein] photos have their own fixed strength (redrawn from her profile picture); 0 turns it off too.
IMAGE_DETAIL_STRENGTH=0.35
# Photos she sends on her own: off | rare | often (asking her in a message always works).
PHOTO_FREQUENCY=rare
# Photo model of realistic characters: flux2-klein (FLUX.2 [klein] 4B, natural bodies and hands;
# run: npm run setup:images -- --flux2-klein) or sdxl (IMAGE_CHECKPOINT). Falls back to sdxl until installed.
REALISTIC_ENGINE=flux2-klein

# --- Anime characters (step 5) -----------------------------------------------------
# Their own image model (run: npm run setup:images -- --anime) and settings.
# Leave ANIME_STYLE / ANIME_NEGATIVE_PROMPT empty for the built-in Animagine defaults.
ANIME_CHECKPOINT=animagine-xl-4.0-opt.safetensors
ANIME_STEPS=28
ANIME_CFG=5
ANIME_SAMPLER=euler_ancestral
ANIME_SCHEDULER=normal
ANIME_STYLE=
ANIME_NEGATIVE_PROMPT=
ANIME_HIRES_SCALE=1
# The face IP-Adapter is trained on photos: off by default for anime (try 0.3–0.5).
ANIME_FACE_WEIGHT=0
ANIME_DETAIL_STRENGTH=0.3

# --- Display -----------------------------------------------------------------------
# Her picture behind the chat: subtle (blurred, dimmed) | clear | off
CHAT_BACKGROUND=subtle

# --- She writes first (step 4d) ---------------------------------------------------
# After this many minutes of silence she sends a message on her own (once). 0 = never.
PROACTIVE_AFTER_MINUTES=60
