{
  "name": "girllm",
  "version": "0.1.0",
  "description": "Local, private AI companion / roleplay chat running on your own GPU (Ollama or any OpenAI-compatible backend).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:voice": "tsx scripts/setupVoice.ts",
    "setup:images": "tsx scripts/setupImages.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "launch": "tsx --disable-warning=ExperimentalWarning scripts/launch.ts",
    "compare": "tsx --disable-warning=ExperimentalWarning scripts/compareModels.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@fastify/static": "^8.1.1",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "fastify": "^5.3.0",
    "sherpa-onnx-node": "^1.13.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.13.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.9.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.0.9"
  }
}
