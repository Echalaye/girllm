{
  "name": "girllm",
  "version": "0.1.0",
  "description": "Local, private AI companion / roleplay chat running on your own GPU (Ollama or any OpenAI-compatible backend).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:voice": "tsx scripts/setupVoice.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.3.0",
    "sherpa-onnx-node": "^1.13.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
